<Page x:Class="EF_Core.Pages.View_Role"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EF_Core.Pages"
      xmlns:services="clr-namespace:EF_Core.Models.Service"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="View_Role"
      Background="White"
      >
    
    <Page.Resources>
        <services:RoleService x:Key="role_Service"/>
    </Page.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="6*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="6*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            
            <!--Левая часть-->
            <StackPanel Grid.Column="0">
                <ComboBox ItemsSource="{Binding Source={StaticResource role_Service},Path=Roles}"
                          DisplayMemberPath="Title"
                          SelectedItem="{Binding current, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="Select_Role"
                          />
            </StackPanel>
            

            <!--Правая часть-->
            <ListView Grid.Column="1" ItemsSource="{Binding Users}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Name}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <StackPanel Grid.Column="1" Grid.Row="2" Style="{StaticResource Button_stack}">
            <Button Content="Добавить"/>
            <Separator Width="10" Visibility="Hidden"/>
            <Button Content="Назад"/>
        </StackPanel>
    </Grid>
</Page>
